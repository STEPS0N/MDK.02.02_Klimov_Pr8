<UserControl x:Class="WeatherReport.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WeatherReport.Elements"
             mc:Ignorable="d" >
    <Border BorderBrush="#FFC7C7C7" Background="White" CornerRadius="10" BorderThickness="0,0,0,1" Padding="15,15" Margin="10">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock x:Name="lDay" Text="2" FontSize="32" FontWeight="Light" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="lMonth" Text="мая," FontSize="12" Foreground="#888"/>
                    <TextBlock x:Name="lToday" Text="12:00" FontSize="12" Foreground="#888"/>
                </StackPanel>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Давление" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Влажность" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Ощущается" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>

                <Border Grid.Row="0" Grid.ColumnSpan="5" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Margin="0,12,0,0" VerticalAlignment="Bottom"/>

                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="lTemp" Text="—" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lCondition" Text="" FontSize="12" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="lPressure" Text="—" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="lHumidity" Text="—" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="4" x:Name="lFeels" Text="—" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
