<Window x:Class="WeatherReport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherReport"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Grid>
        <StackPanel Orientation="Horizontal" Height="45" VerticalAlignment="Top">
            <ComboBox x:Name="days" SelectionChanged="SelectDay" Width="150" Margin="10"/>
            <Label Content="Введите город: " VerticalContentAlignment="Center"/>
            <TextBox x:Name="textCity" Width="250" Height="30" VerticalContentAlignment="Center" FontSize="16"/>
            <Button Content="Поиск" Click="Search" Width="50" Height="25" Margin="10,0,50,0"/>
            <Button Content="Обновить данные" Click="Refresh" Width="150" Margin="10" Height="25"/>
        </StackPanel>
        
        <ScrollViewer Margin="10, 50, 10, 10">
            <StackPanel x:Name="parent">
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
